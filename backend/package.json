{
  "name": "motor-shop-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the AI-Powered Motor Shop Management System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seeders/seed.ts",
    "db:verify": "tsx scripts/verify-datasets.ts",
    "db:studio": "drizzle-kit studio",
    "test:security": "tsx scripts/security-tests.ts",
    "verify": "tsc --noEmit -p tsconfig.json",
    "test:ai": "tsx scripts/ai-tests.ts",
    "test:ba-forecast": "tsx scripts/ba-forecast-tests.ts",
    "test:ba-api": "tsx scripts/ba-api-tests.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "drizzle-orm": "0.44.7",
    "express": "4.21.2",
    "express-rate-limit": "8.1.0",
    "groq-sdk": "^1.6.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.16.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "0.31.4",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
