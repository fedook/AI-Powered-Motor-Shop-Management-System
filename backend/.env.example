NODE_ENV=development
PORT=7000
FRONTEND_URL=http://localhost:5173

# Neon pooled connection string (host contains "-pooler")
DATABASE_URL=
# Optional direct connection used only by migrations/seeders. Falls back to DATABASE_URL.
DIRECT_DATABASE_URL=

JWT_SECRET=
JWT_EXPIRES_IN=1d

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=25000

# Demo accounts created by `npm run db:seed`. Required only for seeding.
ADMIN_EMAIL=admin@motorshop.local
ADMIN_PASSWORD=
STAFF_EMAIL=staff@motorshop.local
STAFF_PASSWORD=

# Production cookie settings. Use "none" + Secure cookies when the frontend
# and API are on different sites (e.g. Vercel -> Render).
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Render/Railway sit behind a reverse proxy; set to 1 in production.
TRUST_PROXY=0
DB_POOL_MAX=10
